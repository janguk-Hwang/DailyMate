# Backend Port
PORT=3001

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_calendar_db

# JWT Secret
JWT_SECRET=todo_calendar_jwt_secret_key_2026

# Frontend Client URL & Base Redirect URL
# 로컬 개발 환경: http://localhost:5173
# Railway 프로덕션 배포 환경: https://dailymate.up.railway.app
CLIENT_URL=http://localhost:5173
REDIRECT_BASE_URL=https://dailymate.up.railway.app

# OAuth 2.0 Social Logins (Optional - Fill when issued)
# [등록할 Callback URL 목록]
# Google: https://dailymate.up.railway.app/api/auth/google/callback
# Kakao:  https://dailymate.up.railway.app/api/auth/kakao/callback
# Naver:  https://dailymate.up.railway.app/api/auth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Gmail SMTP Configuration (dailymate)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
