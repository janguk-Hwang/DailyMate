{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailymates",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "BACKEND_URL": "https://dailymate.up.railway.app",
    "CLIENT_URL": "https://dailymates.hwangw0210.workers.dev",
    "REDIRECT_BASE_URL": "https://dailymates.hwangw0210.workers.dev"
  }
}
